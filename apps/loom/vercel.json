{
    "redirects": [
        {
            "source": "/docs",
            "destination": "/docs/getting-started"
        }
    ],
    "rewrites": [
        {
            "source": "/docs/(.*)",
            "destination": "/docs/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/shell.html"
        }
    ],
    "trailingSlash": false,
    "headers": [
        {
            "source": "/:asset((?:chunk|docs|pages|prism-[a-z]+|font|icon)-[A-Za-z0-9]+\\.(?:js|css|woff2))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
