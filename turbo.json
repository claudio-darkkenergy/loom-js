{
    "$schema": "./node_modules/turbo/schema.json",
    "ui": "tui",
    "globalPassThroughEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
    "tasks": {
        "build": {
            "dependsOn": ["^build", "^build-package"],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,ts,jsx,js,mdx}"],
            "outputs": ["build/**", "storybook-static/**"],
            "env": ["API_URL", "CTF_IS_PREVIEW"]
        },
        "build-package": {
            "dependsOn": ["^build-package"],
            "outputs": ["dist/**"]
        },
        "build-storybook": {
            "dependsOn": ["^build-package"],
            "outputs": ["storybook-static/**"]
        },
        "dev": {
            "dependsOn": ["^build-package"],
            "cache": false,
            "persistent": true,
            "env": ["API_URL", "CTF_IS_PREVIEW"]
        },
        "storybook": {
            "dependsOn": ["^build-package"],
            "cache": false,
            "persistent": true
        },
        "topo": {
            "dependsOn": ["^topo"]
        },
        "type-check": {
            "dependsOn": ["topo"]
        }
    }
}
