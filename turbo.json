{
    "$schema": "./node_modules/turbo/schema.json",
    "ui": "tui",
    "globalPassThroughEnv": [
        "AWS_ROLE_ARN",
        "OPENAI_API_KEY",
        "CTF_SPACE_ID",
        "CTF_TOKEN",
        "API_URL",
        "CTF_IS_PREVIEW"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build", "^build-package"],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,ts,jsx,js,mdx}"],
            "outputs": ["build/**", "storybook-static/**"],
            "env": [
                "API_URL",
                "CTF_IS_PREVIEW",
                "NODE_ENV",
                "CTF_SPACE_ID",
                "CTF_TOKEN"
            ]
        },
        "@loom-js/loom#build": {
            "dependsOn": ["^build", "^build-package", "@loom-js/bench#bench"],
            "cache": false,
            "env": [
                "API_URL",
                "CTF_IS_PREVIEW",
                "NODE_ENV",
                "CTF_SPACE_ID",
                "CTF_TOKEN"
            ]
        },
        "build-package": {
            "dependsOn": ["^build-package"],
            "outputs": ["dist/**"]
        },
        "@loom-js/core#build-package": {
            "dependsOn": ["^build-package"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/topics/**"],
            "outputs": ["dist/**", "llms-full.txt"]
        },
        "@loom-js/bench#bench": {
            "dependsOn": ["^build-package"],
            "outputs": ["results/**"]
        },
        "build-storybook": {
            "dependsOn": ["^build-package"],
            "outputs": ["storybook-static/**"]
        },
        "dev": {
            "dependsOn": ["^build-package"],
            "cache": false,
            "persistent": true,
            "env": ["API_URL", "CTF_IS_PREVIEW"]
        },
        "storybook": {
            "dependsOn": ["^build-package"],
            "cache": false,
            "persistent": true
        },
        "topo": {
            "dependsOn": ["^topo"]
        },
        "type-check": {
            "dependsOn": ["topo"]
        },
        "@loom-js/services#build": {
            "dependsOn": ["^build", "^build-package"],
            "outputs": []
        }
    }
}
