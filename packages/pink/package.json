{
    "name": "@loom-js/pink",
    "version": "0.3.2",
    "author": "Claudio Nunez Jr",
    "license": "ISC",
    "description": "A design system based on Pink Design & made for loomjs.",
    "keywords": [
        "loomjs design system",
        "pink design"
    ],
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "require": "./src/index.js"
        },
        "./styles/*": "./src/styles/*"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/claudio-darkkenergy/loom-js.git",
        "directory": "packages/pink"
    },
    "scripts": {
        "build": "pnpm build-storybook",
        "build-package": "rollup -c rollup.config.ts --configPlugin esbuild",
        "build-storybook": "storybook build",
        "build-storybook-docs": "storybook build --docs",
        "format": "prettier",
        "storybook": "storybook dev --no-open -p 6006",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@appwrite.io/pink": "1.0.0",
        "@appwrite.io/pink-icons": "1.0.0",
        "@loom-js/core": "workspace:*",
        "classnames": "^2.5.1"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.3.1",
        "@loom-js/storybook": "workspace:*",
        "@loom-js/typescript-config": "workspace:*",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/html": "^10.6.0",
        "@storybook/html-vite": "^10.6.0",
        "@types/node": "^26.5.1",
        "esbuild": "^0.28.2",
        "esbuild-node-externals": "^2.0.0",
        "rollup": "^4.63.3",
        "rollup-plugin-delete": "^3.0.2",
        "rollup-plugin-dts": "^6.5.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "storybook": "^10.6.0",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0"
    },
    "peerDependencies": {
        "@loom-js/core": ">=0.6.0 <1.0.0"
    }
}
