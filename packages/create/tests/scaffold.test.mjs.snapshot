  "biome.json": "{\\n    \\"$schema\\": \\"./node_modules/@biomejs/biome/configuration_schema.json\\",\\n    \\"assist\\": {\\n        \\"actions\\": {\\n            \\"source\\": {\\n                \\"organizeImports\\": {\\n                    \\"level\\": \\"on\\",\\n                    \\"options\\": {\\n                        \\"groups\\": [\\n                            [\\":NODE:\\", \\":PACKAGE:\\", \\":PACKAGE_WITH_PROTOCOL:\\"],\\n                            \\":BLANK_LINE:\\",\\n                            [\\":ALIAS:\\", \\":PATH:\\"]\\n                        ]\\n                    }\\n                }\\n            }\\n        }\\n    },\\n    \\"css\\": {\\n        \\"formatter\\": {\\n            \\"quoteStyle\\": \\"single\\"\\n        },\\n        \\"parser\\": {\\n            \\"tailwindDirectives\\": true\\n        }\\n    },\\n    \\"files\\": {\\n        \\"includes\\": [\\n            \\"**\\",\\n            \\"!**/build\\",\\n            \\"!**/.generated\\",\\n            \\"!**/package-lock.json\\",\\n            \\"!**/pnpm-lock.yaml\\",\\n            \\"!**/yarn.lock\\",\\n            \\"!**/bun.lock\\"\\n        ]\\n    },\\n    \\"formatter\\": {\\n        \\"indentStyle\\": \\"space\\",\\n        \\"indentWidth\\": 4,\\n        \\"lineWidth\\": 80\\n    },\\n    \\"javascript\\": {\\n        \\"formatter\\": {\\n            \\"quoteStyle\\": \\"single\\",\\n            \\"semicolons\\": \\"always\\",\\n            \\"trailingCommas\\": \\"none\\"\\n        }\\n    },\\n    \\"linter\\": {\\n        \\"enabled\\": false\\n    },\\n    \\"yaml\\": {\\n        \\"formatter\\": {\\n            \\"quoteStyle\\": \\"single\\"\\n        }\\n    }\\n}\\n",
  "jsconfig.json": "{\\n    \\"compilerOptions\\": {\\n        \\"module\\": \\"ESNext\\",\\n        \\"moduleResolution\\": \\"Bundler\\",\\n        \\"paths\\": {\\n            \\"@app/*\\": [\\"./src/*\\"]\\n        },\\n        \\"target\\": \\"ES2022\\"\\n    },\\n    \\"include\\": [\\"src\\", \\"loom.config.mjs\\"]\\n}\\n",
  "loom.config.mjs": "import { defineConfig } from '@loom-js/build';\\n\\nimport { routes } from './src/routes';\\n\\nexport default defineConfig({\\n    entry: './src/bootstrap',\\n    html: {\\n        bodyClass: 'theme-light',\\n        title: () => 'app'\\n    },\\n    routes,\\n    styles: ['./public/styles/base.css', './.generated/styles.css']\\n});\\n",
  "package.json": "{\\n    \\"name\\": \\"app\\",\\n    \\"version\\": \\"0.0.0\\",\\n    \\"private\\": true,\\n    \\"type\\": \\"module\\",\\n    \\"scripts\\": {\\n        \\"build\\": \\"tailwindcss -i ./src/styles.css -o ./.generated/styles.css && loom build\\",\\n        \\"dev\\": \\"node scripts/dev.mjs\\",\\n        \\"format\\": \\"biome check --write\\",\\n        \\"format:check\\": \\"biome check\\"\\n    },\\n    \\"dependencies\\": {\\n        \\"@loom-js/core\\": \\"<range>\\",\\n        \\"@loom-js/pink\\": \\"<range>\\"\\n    },\\n    \\"devDependencies\\": {\\n        \\"@biomejs/biome\\": \\"<range>\\",\\n        \\"@loom-js/build\\": \\"<range>\\",\\n        \\"@loom-js/devtools\\": \\"<range>\\",\\n        \\"@tailwindcss/cli\\": \\"<range>\\",\\n        \\"tailwindcss\\": \\"<range>\\"\\n    }\\n}\\n",
  "README.md": "# app\\n\\nA [loom](https://loom-js-docs.vercel.app/docs) app, created with \`@loom-js/create\`.\\n\\n## Scripts\\n\\n- \`npm run dev\`: start the dev server, reloading on every change.\\n- \`npm run build\`: build the app into \`build/\`.\\n- \`npm run format\`: format every file with Biome.\\n- \`npm run format:check\`: fail on any unformatted file.\\n",
  "src/bootstrap.js": "import { APP_ROOT_ID, init } from '@loom-js/core';\\nimport '@loom-js/pink/icons.css';\\n\\nimport { App } from './app';\\n\\n// Reloads the page when \`loom dev\` rebuilds; production builds drop it.\\nif (__DEV__) {\\n    new EventSource('/esbuild').addEventListener('change', () =>\\n        location.reload()\\n    );\\n}\\n\\ninit({ app: App(), root: document.getElementById(APP_ROOT_ID) });\\n",
  "src/styles.css": "/* Pink (@loom-js/pink) first: its layer order puts Tailwind's preflight\\n   before the kit and Tailwind's utilities after it. */\\n@import '@loom-js/pink/pink.css';\\n@import 'tailwindcss';\\n\\n/* Kit classes Tailwind would also generate as utilities. */\\n@source not inline('container list-item table table-row');\\n"
}
`;

