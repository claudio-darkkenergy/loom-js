  "package.json": "{\\n    \\"name\\": \\"app\\",\\n    \\"version\\": \\"0.0.0\\",\\n    \\"private\\": true,\\n    \\"type\\": \\"module\\",\\n    \\"scripts\\": {\\n        \\"build\\": \\"tailwindcss -i ./src/styles.css -o ./.generated/styles.css && loom build\\",\\n        \\"dev\\": \\"node scripts/dev.mjs\\",\\n        \\"format\\": \\"biome check --write\\",\\n        \\"format:check\\": \\"biome check\\",\\n        \\"type-check\\": \\"tsc --noEmit\\"\\n    },\\n    \\"dependencies\\": {\\n        \\"@loom-js/core\\": \\"<range>\\",\\n        \\"@loom-js/pink\\": \\"<range>\\"\\n    },\\n    \\"devDependencies\\": {\\n        \\"@biomejs/biome\\": \\"<range>\\",\\n        \\"@loom-js/build\\": \\"<range>\\",\\n        \\"@loom-js/devtools\\": \\"<range>\\",\\n        \\"@tailwindcss/cli\\": \\"<range>\\",\\n        \\"tailwindcss\\": \\"<range>\\",\\n        \\"typescript\\": \\"<range>\\"\\n    }\\n}\\n",
  "README.md": "# app\\n\\nA [loom](https://loom-js-docs.vercel.app/docs) app, created with \`@loom-js/create\`.\\n\\n## Scripts\\n\\n- \`npm run dev\`: start the dev server, reloading on every change.\\n- \`npm run build\`: build the app into \`build/\`, prerendering every route.\\n- \`npm run type-check\`: type-check with \`tsc\`.\\n- \`npm run format\`: format every file with Biome.\\n- \`npm run format:check\`: fail on any unformatted file.\\n",
  "src/bootstrap.ts": "import {\\n    APP_ROOT_ID,\\n    hydrate,\\n    primeResources,\\n    STATE_SCRIPT_ID\\n} from '@loom-js/core';\\nimport '@loom-js/pink/icons.css';\\n\\nimport { App } from './app';\\n\\n// Reloads the page when \`loom dev\` rebuilds; production builds drop it.\\nif (__DEV__) {\\n    new EventSource('/esbuild').addEventListener('change', () =>\\n        location.reload()\\n    );\\n}\\n\\n// A prerendered page embeds its state; prime it so nothing refetches.\\nconst payload = document.getElementById(STATE_SCRIPT_ID)?.textContent;\\n\\nif (payload) {\\n    primeResources(JSON.parse(payload));\\n}\\n\\nhydrate({ app: App(), root: document.getElementById(APP_ROOT_ID) });\\n",
  "src/styles.css": "/* Pink (@loom-js/pink) first: its layer order puts Tailwind's preflight\\n   before the kit and Tailwind's utilities after it. */\\n@import '@loom-js/pink/pink.css';\\n@import 'tailwindcss';\\n\\n/* Kit classes Tailwind would also generate as utilities. */\\n@source not inline('container list-item table table-row');\\n",
  "tsconfig.json": "{\\n    \\"compilerOptions\\": {\\n        \\"esModuleInterop\\": true,\\n        \\"isolatedModules\\": true,\\n        \\"lib\\": [\\"ES2022\\", \\"DOM\\", \\"DOM.Iterable\\"],\\n        \\"module\\": \\"ESNext\\",\\n        \\"moduleDetection\\": \\"force\\",\\n        \\"moduleResolution\\": \\"Bundler\\",\\n        \\"noEmit\\": true,\\n        \\"noUncheckedIndexedAccess\\": true,\\n        \\"resolveJsonModule\\": true,\\n        \\"skipLibCheck\\": true,\\n        \\"strict\\": true,\\n        \\"target\\": \\"ES2022\\",\\n        \\"paths\\": {\\n            \\"@app/*\\": [\\"./src/*\\"]\\n        }\\n    },\\n    \\"include\\": [\\"src\\", \\"loom.config.ts\\"]\\n}\\n"
}
`;
