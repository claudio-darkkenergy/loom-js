  "apps/web/loom.config.mjs": "import { defineConfig } from '@loom-js/build';\\n\\nimport { routes } from './src/routes';\\n\\nexport default defineConfig({\\n    entry: './src/bootstrap',\\n    html: {\\n        bodyClass: 'theme-light',\\n        title: () => 'app'\\n    },\\n    prerender: {\\n        entry: './src/prerender.entry',\\n        routes: () => routes\\n    },\\n    routes,\\n    styles: ['./public/styles/base.css', './.generated/styles.css']\\n});\\n",
