  "jsconfig.json": "{\\n    \\"compilerOptions\\": {\\n        \\"module\\": \\"ESNext\\",\\n        \\"moduleResolution\\": \\"Bundler\\",\\n        \\"paths\\": {\\n            \\"@app/*\\": [\\"./src/*\\"]\\n        },\\n        \\"target\\": \\"ES2022\\"\\n    },\\n    \\"include\\": [\\"src\\", \\"loom.config.mjs\\"]\\n}\\n",
  "loom.config.mjs": "import { defineConfig } from '@loom-js/build';\\n\\nimport { routes } from './src/routes';\\n\\nexport default defineConfig({\\n    entry: './src/bootstrap',\\n    html: {\\n        title: () => 'app'\\n    },\\n    prerender: {\\n        entry: './src/prerender.entry',\\n        routes: () => routes\\n    },\\n    routes,\\n    styles: ['./public/styles/base.css']\\n});\\n",
  "package.json": "{\\n    \\"name\\": \\"app\\",\\n    \\"version\\": \\"0.0.0\\",\\n    \\"private\\": true,\\n    \\"type\\": \\"module\\",\\n    \\"scripts\\": {\\n        \\"build\\": \\"loom build\\",\\n        \\"dev\\": \\"loom dev\\",\\n        \\"format\\": \\"biome check --write\\",\\n        \\"format:check\\": \\"biome check\\"\\n    },\\n    \\"dependencies\\": {\\n        \\"@loom-js/core\\": \\"<range>\\"\\n    },\\n    \\"devDependencies\\": {\\n        \\"@biomejs/biome\\": \\"<range>\\",\\n        \\"@loom-js/build\\": \\"<range>\\",\\n        \\"@loom-js/devtools\\": \\"<range>\\"\\n    }\\n}\\n",
  "README.md": "# app\\n\\nA [loom](https://loom-js-docs.vercel.app/docs) app, created with \`@loom-js/create\`.\\n\\n## Scripts\\n\\n- \`npm run dev\`: start the dev server, reloading on every change.\\n- \`npm run build\`: build the app into \`build/\`, prerendering every route.\\n- \`npm run format\`: format every file with Biome.\\n- \`npm run format:check\`: fail on any unformatted file.\\n",
  "src/bootstrap.js": "import {\\n    APP_ROOT_ID,\\n    hydrate,\\n    primeResources,\\n    STATE_SCRIPT_ID\\n} from '@loom-js/core';\\n\\nimport { App } from './app';\\n\\n// Reloads the page when \`loom dev\` rebuilds; production builds drop it.\\nif (__DEV__) {\\n    new EventSource('/esbuild').addEventListener('change', () =>\\n        location.reload()\\n    );\\n}\\n\\n// A prerendered page embeds its state; prime it so nothing refetches.\\nconst payload = document.getElementById(STATE_SCRIPT_ID)?.textContent;\\n\\nif (payload) {\\n    primeResources(JSON.parse(payload));\\n}\\n\\nhydrate({ app: App(), root: document.getElementById(APP_ROOT_ID) });\\n"
}
