  "biome.json": "{\\n    \\"$schema\\": \\"./node_modules/@biomejs/biome/configuration_schema.json\\",\\n    \\"assist\\": {\\n        \\"actions\\": {\\n            \\"source\\": {\\n                \\"organizeImports\\": {\\n                    \\"level\\": \\"on\\",\\n                    \\"options\\": {\\n                        \\"groups\\": [\\n                            [\\":NODE:\\", \\":PACKAGE:\\", \\":PACKAGE_WITH_PROTOCOL:\\"],\\n                            \\":BLANK_LINE:\\",\\n                            [\\":ALIAS:\\", \\":PATH:\\"]\\n                        ]\\n                    }\\n                }\\n            }\\n        }\\n    },\\n    \\"css\\": {\\n        \\"formatter\\": {\\n            \\"quoteStyle\\": \\"single\\"\\n        },\\n        \\"parser\\": {\\n            \\"tailwindDirectives\\": true\\n        }\\n    },\\n    \\"files\\": {\\n        \\"includes\\": [\\n            \\"**\\",\\n            \\"!**/build\\",\\n            \\"!**/.generated\\",\\n            \\"!**/package-lock.json\\",\\n            \\"!**/pnpm-lock.yaml\\",\\n            \\"!**/yarn.lock\\",\\n            \\"!**/bun.lock\\"\\n        ]\\n    },\\n    \\"formatter\\": {\\n        \\"indentStyle\\": \\"space\\",\\n        \\"indentWidth\\": 4,\\n        \\"lineWidth\\": 80\\n    },\\n    \\"javascript\\": {\\n        \\"formatter\\": {\\n            \\"quoteStyle\\": \\"single\\",\\n            \\"semicolons\\": \\"always\\",\\n            \\"trailingCommas\\": \\"none\\"\\n        }\\n    },\\n    \\"linter\\": {\\n        \\"enabled\\": false\\n    },\\n    \\"yaml\\": {\\n        \\"formatter\\": {\\n            \\"quoteStyle\\": \\"single\\"\\n        }\\n    }\\n}\\n",
  "loom.config.ts": "import { defineConfig } from '@loom-js/build';\\n\\nimport { routes } from './src/routes';\\n\\nexport default defineConfig({\\n    entry: './src/bootstrap',\\n    html: {\\n        title: () => 'app'\\n    },\\n    prerender: {\\n        entry: './src/prerender.entry',\\n        routes: () => routes\\n    },\\n    routes,\\n    styles: ['./public/styles/base.css', './.generated/styles.css']\\n});\\n",
  "package.json": "{\\n    \\"name\\": \\"app\\",\\n    \\"version\\": \\"0.0.0\\",\\n    \\"private\\": true,\\n    \\"type\\": \\"module\\",\\n    \\"scripts\\": {\\n        \\"build\\": \\"tailwindcss -i ./src/styles.css -o ./.generated/styles.css && loom build\\",\\n        \\"dev\\": \\"node scripts/dev.mjs\\",\\n        \\"format\\": \\"biome check --write\\",\\n        \\"format:check\\": \\"biome check\\",\\n        \\"type-check\\": \\"tsc --noEmit\\"\\n    },\\n    \\"dependencies\\": {\\n        \\"@loom-js/core\\": \\"<range>\\"\\n    },\\n    \\"devDependencies\\": {\\n        \\"@biomejs/biome\\": \\"<range>\\",\\n        \\"@loom-js/build\\": \\"<range>\\",\\n        \\"@loom-js/devtools\\": \\"<range>\\",\\n        \\"@tailwindcss/cli\\": \\"<range>\\",\\n        \\"tailwindcss\\": \\"<range>\\",\\n        \\"typescript\\": \\"<range>\\"\\n    }\\n}\\n",
  "README.md": "# app\\n\\nA [loom](https://loom-js-docs.vercel.app/docs) app, created with \`@loom-js/create\`.\\n\\n## Scripts\\n\\n- \`npm run dev\`: start the dev server, reloading on every change.\\n- \`npm run build\`: build the app into \`build/\`, prerendering every route.\\n- \`npm run type-check\`: type-check with \`tsc\`.\\n- \`npm run format\`: format every file with Biome.\\n- \`npm run format:check\`: fail on any unformatted file.\\n",
  "src/bootstrap.ts": "import {\\n    APP_ROOT_ID,\\n    hydrate,\\n    primeResources,\\n    STATE_SCRIPT_ID\\n} from '@loom-js/core';\\n\\nimport { App } from './app';\\n\\n// Reloads the page when \`loom dev\` rebuilds; production builds drop it.\\nif (__DEV__) {\\n    new EventSource('/esbuild').addEventListener('change', () =>\\n        location.reload()\\n    );\\n}\\n\\n// A prerendered page embeds its state; prime it so nothing refetches.\\nconst payload = document.getElementById(STATE_SCRIPT_ID)?.textContent;\\n\\nif (payload) {\\n    primeResources(JSON.parse(payload));\\n}\\n\\nhydrate({ app: App(), root: document.getElementById(APP_ROOT_ID) });\\n",
  "src/styles.css": "@import 'tailwindcss';\\n",
  "tsconfig.json": "{\\n    \\"compilerOptions\\": {\\n        \\"esModuleInterop\\": true,\\n        \\"isolatedModules\\": true,\\n        \\"lib\\": [\\"ES2022\\", \\"DOM\\", \\"DOM.Iterable\\"],\\n        \\"module\\": \\"ESNext\\",\\n        \\"moduleDetection\\": \\"force\\",\\n        \\"moduleResolution\\": \\"Bundler\\",\\n        \\"noEmit\\": true,\\n        \\"noUncheckedIndexedAccess\\": true,\\n        \\"resolveJsonModule\\": true,\\n        \\"skipLibCheck\\": true,\\n        \\"strict\\": true,\\n        \\"target\\": \\"ES2022\\",\\n        \\"paths\\": {\\n            \\"@app/*\\": [\\"./src/*\\"]\\n        }\\n    },\\n    \\"include\\": [\\"src\\", \\"loom.config.ts\\"]\\n}\\n"
}
`;

