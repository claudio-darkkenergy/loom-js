{
  ".gitignore": "node_modules\\nbuild\\n.DS_Store\\n*.log\\n.turbo\\n",
  "apps/web/jsconfig.json": "{\\n    \\"compilerOptions\\": {\\n        \\"module\\": \\"ESNext\\",\\n        \\"moduleResolution\\": \\"Bundler\\",\\n        \\"paths\\": {\\n            \\"@app/*\\": [\\"./src/*\\"]\\n        },\\n        \\"target\\": \\"ES2022\\"\\n    },\\n    \\"include\\": [\\"src\\", \\"loom.config.mjs\\"]\\n}\\n",
  "apps/web/loom.config.mjs": "import { defineConfig } from '@loom-js/build';\\n\\nimport { routes } from './src/routes';\\n\\nexport default defineConfig({\\n    entry: './src/bootstrap',\\n    html: {\\n        title: () => 'app'\\n    },\\n    routes,\\n    styles: ['./public/styles/base.css']\\n});\\n",
  "apps/web/package.json": "{\\n    \\"name\\": \\"web\\",\\n    \\"version\\": \\"0.0.0\\",\\n    \\"private\\": true,\\n    \\"type\\": \\"module\\",\\n    \\"scripts\\": {\\n        \\"build\\": \\"loom build\\",\\n        \\"dev\\": \\"loom dev\\"\\n    },\\n    \\"dependencies\\": {\\n        \\"@loom-js/core\\": \\"<range>\\"\\n    },\\n    \\"devDependencies\\": {\\n        \\"@loom-js/build\\": \\"<range>\\",\\n        \\"@loom-js/devtools\\": \\"<range>\\"\\n    }\\n}\\n",
