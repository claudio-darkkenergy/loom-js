{
    "name": "@loom-js/highlight",
    "version": "0.0.0",
    "author": "Claudio Nunez Jr",
    "license": "ISC",
    "description": "Syntax highlighting for loom UI libraries: a pure text→tokens tokenizer (Prism) behind a lazy-import activity, with a UI-library-agnostic token vocabulary.",
    "keywords": [
        "loomjs",
        "syntax highlighting",
        "prism",
        "code tokens"
    ],
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "require": "./src/index.js"
        }
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/claudio-darkkenergy/loom-js.git",
        "directory": "packages/highlight"
    },
    "scripts": {
        "build-package": "rollup -c rollup.config.ts --configPlugin esbuild",
        "format": "prettier",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "prismjs": "^1.30.0"
    },
    "devDependencies": {
        "@loom-js/core": "workspace:*",
        "@loom-js/typescript-config": "workspace:*",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/node": "^26.1.2",
        "@types/prismjs": "^1.26.6",
        "rollup": "^4.62.4",
        "rollup-plugin-delete": "^3.0.2",
        "rollup-plugin-dts": "^6.4.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@loom-js/core": ">=0.7.0 <1.0.0"
    }
}
