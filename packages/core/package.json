{
    "name": "@loom-js/core",
    "version": "0.5.2",
    "author": "Claudio Nunez Jr",
    "license": "ISC",
    "description": "A reactive, component-driven, JavaScript framework.",
    "keywords": [
        "javascript framework",
        "reactive",
        "component-driven",
        "lightweight",
        "web development",
        "front-end framework"
    ],
    "exports": {
        "module": "./dist/index.mjs",
        "default": "./dist/index.js"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "./dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/darkkenergy/loomjs",
        "directory": "packages/core"
    },
    "scripts": {
        "build-package": "rollup -c rollup.config.ts --configPlugin esbuild",
        "format": "prettier",
        "test-ci": "wtr --config \"web-test-runner.config.mjs\"",
        "test-dev": "wtr --config \"web-test-runner.config.mjs\" --watch",
        "test-debug": "wtr --config \"web-test-runner.config.mjs\" --watch --debug",
        "type-check": "tsc --noEmit",
        "type-check-tests": "tsc -p tests/tsconfig.json"
    },
    "devDependencies": {
        "@esm-bundle/chai": "4.3.4-fix.0",
        "@loom-js/typescript-config": "workspace:*",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@testing-library/dom": "^10.4.1",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.1.2",
        "@types/sinon": "22.0.0",
        "@web/dev-server-esbuild": "^2.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-puppeteer": "^1.0.1",
        "pptr-testing-library": "0.8.0",
        "puppeteer": "^25.4.0",
        "rollup": "^4.62.4",
        "rollup-plugin-delete": "^3.0.2",
        "rollup-plugin-dts": "^6.4.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "sinon": "22.1.0",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2"
    }
}
